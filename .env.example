# Copy this file to a new file called .env and fill in your own values.
# The .env file is private and is never saved to Git.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://gymos:gymos_dev_password@localhost:5432/gymos

# Only when the app is reached through another address over HTTPS
# (a server's domain, or a test tunnel to your phone). See docs/operations.md.
# CSRF_TRUSTED_ORIGINS=https://gym.example.rw
# BEHIND_HTTPS_PROXY=True
